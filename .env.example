# Keep all existing NEXT_PUBLIC_FIREBASE_* values in Vercel.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Required for business notifications + customer confirmation emails.
RESEND_API_KEY=
# apexweb.au was verified in Resend on the October 2026 readiness check.
EMAIL_FROM=APEXWEB <enquiries@apexweb.au>

# Server-only, endpoint-specific signing secrets. Never use NEXT_PUBLIC_.
# Production accepts LIVE events only with this secret.
STRIPE_WEBHOOK_SECRET=
# Separate sandbox signing secret. Sandbox emails are explicitly labelled.
STRIPE_TEST_WEBHOOK_SECRET=

# Current public origin.
NEXT_PUBLIC_SITE_URL=https://apexweb.au
