# Keep all existing NEXT_PUBLIC_FIREBASE_* values in Vercel.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Required for business notifications + customer confirmation emails.
RESEND_API_KEY=
# Sender domain must first be verified in Resend. Until then use the Resend
# onboarding sender: APEXWEB <onboarding@resend.dev> (delivers only to the
# Resend account owner's email address).
EMAIL_FROM=APEXWEB <onboarding@resend.dev>

# Set in Vercel Production after apexweb.au resolves correctly.
NEXT_PUBLIC_SITE_URL=https://apexweb.au
